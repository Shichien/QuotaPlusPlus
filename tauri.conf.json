{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaPlusPlus",
  "version": "0.2.0",
  "identifier": "app.quotaplusplus.desktop",
  "build": { "frontendDist": "frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "QuotaPlusPlus",
      "width": 680,
      "height": 460,
      "minWidth": 560,
      "minHeight": 420,
      "center": true,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
